<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <IdolStudioBuildDir Condition="'$(IdolStudioBuildDir)' == ''">$(MSBuildProjectDirectory)\..\..\..\idol\src\Idol.Inference\bin\Release\net9.0-windows</IdolStudioBuildDir>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="Idol.Inference"><HintPath>$(IdolStudioBuildDir)\Idol.Inference.dll</HintPath></Reference>
    <Reference Include="Idol.Core"><HintPath>$(IdolStudioBuildDir)\Idol.Core.dll</HintPath></Reference>
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.107.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.22" />
  </ItemGroup>
  <Target Name="RequireIdolStudio" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(IdolStudioBuildDir)\Idol.Inference.dll')" Text="Build Idol Studio separately, then pass -p:IdolStudioBuildDir=its Release/net9.0-windows directory. This tool never builds or edits that repository." />
  </Target>
</Project>
